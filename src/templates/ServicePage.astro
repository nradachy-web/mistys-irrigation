---
/* ============================================================================
   A SERVICE PAGE

     1  hero       keyword line, display line, paragraph, ticks, two actions
     2  blocks     whatever the service needs, in the order its JSON lists them
     3  mist       the questions, then the towns
     4  ink        the booking form beside the phone
   Copy comes from src/content/services/<id>.json.
   ========================================================================== */
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Head from '../components/Head.astro';
import Blocks from '../components/Blocks.astro';
import Faq from '../components/Faq.astro';
import QuoteBand from '../components/QuoteBand.astro';
import AreaChips from '../components/AreaChips.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { BRAND } from '../data/site';
import { SERVICES, service as getService } from '../data/services';
import type { PhotoId } from '../data/photos';
import { heroImage } from '../lib/hero';
import { breadcrumbs, faqSchema, serviceSchema } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'services'>;
}
const { entry } = Astro.props;
const c = entry.data;
const svc = getService(c.service as any);
const hero = await heroImage(c.hero.photo as PhotoId);
const lastPlane = c.blocks[c.blocks.length - 1].plane;
const faqPlane = lastPlane === 'mist' ? 'white' : 'mist';
const related = SERVICES.filter((s) => s.id !== svc.id && (s.group === svc.group || s.id === 'sprinkler-repair')).slice(0, 3);

const schema = [
  serviceSchema({ name: svc.name, type: svc.name, description: c.meta.description, url: `${BRAND.origin}${svc.path}` }),
  faqSchema(c.faq),
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: svc.name, path: svc.path },
  ]),
];
---

<Base ogImage={hero.fallback} title={c.meta.title} description={c.meta.description} path={svc.path} preload={hero.preload} schema={schema}>
  <Hero image={hero} kicker={c.hero.kicker} title={c.hero.title} lede={c.hero.lede} chips={c.hero.chips} crumbs={[{ name: 'Services', path: '/services/' }, { name: svc.name, path: svc.path }]} />

  <Blocks blocks={c.blocks} service={svc} />

  <section class:list={['band', faqPlane === 'white' && 'white']} aria-labelledby="faq-h">
    <div class="wrap faqs">
      <Head
        id="faq-h"
        layout="left"
        eyebrow="Questions"
        title={`What people ask about ${svc.noun}.`}
        intro={c.faqIntro ?? `The things people ask before booking. If yours is not here, call or text [${BRAND.phone}](${BRAND.phoneHref}).`}
      />
      <Faq items={c.faq} />
    </div>
    <div class="wrap more">
      <h2 class="h3">{svc.name} near you</h2>
      <AreaChips service={svc} />
    </div>
  </section>

  <section class:list={['band', 'tight', faqPlane === 'white' ? '' : 'white']} aria-labelledby="rel-h">
    <div class="wrap">
      <Head id="rel-h" eyebrow="Also" title="Often booked **with this.**" small />
      <ServiceCards services={related} />
    </div>
  </section>

  <QuoteBand title={c.quote?.title} lede={c.quote?.lede} service={svc.ask} avoid={[c.hero.photo]} />
</Base>

<style>
  .faqs {
    display: grid;
    gap: 1rem;
  }

  .more {
    display: grid;
    gap: 0.9rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 72rem) {
    .faqs {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }

    .faqs :global(.head) {
      position: sticky;
      top: calc(var(--header) + 2rem);
    }
  }
</style>
