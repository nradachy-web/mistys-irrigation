---
/* Services as photo cards. The whole card is the link; the photo eases in on
   hover. An AI picture says "Illustration" in its corner. */
import Photo from './Photo.astro';
import { photo } from '../data/photos';
import { href } from '../lib/paths';
import type { Service } from '../data/services';
import { townPath, type City } from '../data/cities';

interface Props {
  services: Service[];
  /** Link to the town version of each service where it exists. */
  town?: City;
  columns?: 2 | 3 | 4;
}
const { services, town, columns = 3 } = Astro.props;
---

<ul class:list={['sc', `sc--${columns}`]}>
  {
    services.map((s) => {
      const p = photo(s.photo);
      return (
        <li>
          <a class="sc__card" href={href(town ? townPath(s, town) : s.path)}>
            <div class="sc__img">
              <Photo id={s.photo} ratio={4 / 3} widths={[360, 540, 720]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw" />
              {p.kind === 'ai' && <span class="sc__tag">Illustration</span>}
            </div>
            <div class="sc__body">
              <h3 class="h3">{town ? `${s.name} in ${town.name}` : s.name}</h3>
              <p class="small muted">{s.teaser}</p>
              <span class="arrow">Learn more</span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .sc {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 40rem) {
    .sc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .sc--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .sc--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sc__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--white);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .sc__card:hover {
    border-color: rgb(194 28 116 / 0.45);
    box-shadow: 0 18px 40px -22px rgb(14 22 36 / 0.45);
    transform: translateY(-2px);
  }

  :global(.ink) .sc__card {
    border-color: var(--line-ink);
    background: var(--ink-2);
  }

  :global(.ink) .sc__card:hover {
    border-color: rgb(255 103 178 / 0.5);
  }

  .sc__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-3);
  }

  .sc__img :global(picture),
  .sc__img :global(img) {
    width: 100%;
    height: 100%;
  }

  .sc__img :global(img) {
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .sc__card:hover .sc__img :global(img) {
    transform: scale(1.04);
  }

  .sc__tag {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-sm);
    background: rgb(11 18 32 / 0.72);
    color: #dbe3ee;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .sc__body {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    flex: 1;
    padding: 1.15rem 1.25rem 0.75rem;
  }

  .sc__body .arrow {
    margin-top: auto;
  }
</style>
