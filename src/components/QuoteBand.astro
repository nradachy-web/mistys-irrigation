---
/* The closing band on every selling page: the form beside the phone, on the
   pre-dawn ink with the misty lake photo fading in behind it. On a phone the form
   comes straight after the words, because that is what the button the visitor
   just tapped promised. */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import QuoteForm from './QuoteForm.astro';
import { BRAND } from '../data/site';
import type { PhotoId } from '../data/photos';
import { rich } from '../lib/rich';

interface Props {
  title?: string;
  lede?: string;
  eyebrow?: string;
  /** Pre-ticks the matching form choice (a service's `ask`). */
  service?: string;
  town?: string;
  /** Photos this page already shows. */
  avoid?: string[];
}
const {
  eyebrow = 'Book service',
  title = 'Tell us what the system is doing.',
  lede = 'Send it here or call. We will call back, ask a couple of questions so the right parts are on the truck, and give you a time.',
  service,
  town,
  avoid = [],
} = Astro.props;

const OPTIONS: PhotoId[] = ['estate-clouds', 'colonial-mist', 'lake-lawn', 'street-sprinklers'];
const seed = [...Astro.url.pathname].reduce((a, c) => a + c.charCodeAt(0), 0);
const open = OPTIONS.filter((o) => !avoid.includes(o));
const bg = open[seed % open.length] ?? 'estate-clouds';
---

<section class="band ink quote" aria-labelledby="quote-h">
  <div class="quote__bg" aria-hidden="true">
    <Photo id={bg} alt="" widths={[828, 1320]} sizes="100vw" quality={40} />
  </div>
  <div class="wrap quote__grid">
    <div class="quote__head stack" style="--gap:1.15rem">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2" id="quote-h">{title}</h2>
      <p class="lede" set:html={rich(lede)} />
      <ul class="checks small quote__checks">
        <li>A real person calls you back. Promptness is what reviewers mention most.</li>
        <li>Fair, clear pricing. That is the second thing they mention.</li>
        <li>Licensed and insured, family run out of Fenton.</li>
      </ul>
    </div>

    <div class="quote__form light" id="quote">
      <QuoteForm service={service} town={town} />
    </div>

    <div class="quote__rest stack" style="--gap:1.25rem">
      <a class="quote__phone" href={BRAND.phoneHref} data-loc="quote-band">
        <span class="fine muted">To talk now, call or text</span>
        <span class="quote__num num">{BRAND.phone}</span>
      </a>
      <a class="btn ghost quote__text" href={BRAND.smsHref} data-loc="quote-band-text"><Icon name="text" />Text us a photo of the problem</a>
    </div>
  </div>
</section>

<style>
  .quote {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .quote__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
  }

  .quote__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--ink) 0%, rgb(11 18 32 / 0.55) 40%, var(--ink) 100%),
      linear-gradient(90deg, var(--ink) 10%, transparent 70%);
  }

  .quote__bg :global(picture),
  .quote__bg :global(img) {
    width: 100%;
    height: 100%;
  }

  .quote__bg :global(img) {
    object-fit: cover;
  }

  .quote__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .quote__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas:
        'head form'
        'rest form';
      column-gap: clamp(2.5rem, 6vw, 5.5rem);
      align-items: start;
    }

    .quote__head {
      grid-area: head;
    }

    .quote__form {
      grid-area: form;
    }

    .quote__rest {
      grid-area: rest;
      align-self: start;
    }
  }

  .quote__checks {
    margin-top: 1.5rem;
    color: var(--on-ink-muted);
  }

  .quote__form {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-radius: calc(var(--r) + 4px);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.7);
    scroll-margin-top: calc(var(--header) + 1rem);
  }

  .quote__phone {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
  }

  .quote__num {
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    font-weight: 740;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .quote__phone:hover .quote__num {
    color: var(--pink-on-ink);
  }

  .quote__text {
    justify-self: start;
  }
</style>
