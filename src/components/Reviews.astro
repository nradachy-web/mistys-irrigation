---
/* Google reviews, word for word, beside the rating and what reviewers mention
   most. The rating card links to the listing so anyone can read the rest. */
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import { LINKS, RATING, REVIEW_TOPICS } from '../data/site';
import type { Review } from '../data/reviews';

interface Props {
  reviews: Review[];
  /** Show the rating card with review topics first. */
  summary?: boolean;
}
const { reviews, summary = true } = Astro.props;
---

<div class:list={['rv', summary && 'rv--sum']}>
  {
    summary && (
      <div class="rv__sum card pad">
        <p class="rv__score"><span class="num">{RATING.value}</span><Stars label={`${RATING.value} out of 5 stars`} /></p>
        <p class="small muted">From {RATING.countLabel} reviews on Google.</p>
        <p class="fine rv__topics-h">What people mention most</p>
        <ul class="rv__topics">
          {REVIEW_TOPICS.map((t) => <li><span>{t.name}</span><b class="num">{t.count}</b></li>)}
        </ul>
        <a class="arrow" href={LINKS.google} target="_blank" rel="noopener">Read them on Google</a>
      </div>
    )
  }
  {
    reviews.map((r) => (
      <figure class="rv__card card pad">
        <Stars />
        <blockquote>
          <p>{r.text}</p>
        </blockquote>
        <figcaption>
          <span class="rv__who">{r.name}</span>
          <span class="rv__job fine muted"><Icon name="google" />{r.job}, Google review</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .rv {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 48rem) {
    .rv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .rv {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .rv--sum {
      grid-template-columns: minmax(0, 0.9fr) repeat(3, minmax(0, 1fr));
    }
  }

  .rv__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rv__card blockquote {
    margin: 0;
    flex: 1;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .rv__card figcaption {
    display: grid;
    gap: 0.15rem;
  }

  .rv__who {
    font-weight: 680;
  }

  .rv__job {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .rv__job :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .rv__sum {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .rv__score {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 3.4rem;
    font-weight: 760;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .rv__score :global(.stars) {
    font-size: 1.1rem;
  }

  .rv__topics-h {
    margin-top: 0.6rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rv__topics {
    display: grid;
    gap: 0.1rem;
    margin-bottom: 0.4rem;
  }

  .rv__topics li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  :global(.ink) .rv__topics li {
    border-color: var(--line-ink);
  }

  .rv__topics b {
    font-weight: 680;
  }
</style>
