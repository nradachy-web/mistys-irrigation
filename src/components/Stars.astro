---
/* Five filled stars. The number beside them is always written out in text. */
interface Props {
  label?: string;
}
const { label } = Astro.props;
const star = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 2.6 2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5-4.9-4.5 6.6-.8z"/></svg>';
---

<span class="stars" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={star.repeat(5)} />
