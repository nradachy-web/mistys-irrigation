---
/* The page shell. Everything a page needs to score: one inlined stylesheet, one
   preloaded subset font (the italic loads only where a heading uses it), a
   preloaded hero image and no blocking script. */
import '../styles/global.css';
import fontText from '../assets/fonts/MistyText.woff2?url';
import fontItalic from '../assets/fonts/MistyItalic.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Tracking from '../components/Tracking.astro';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';
import { business, businessRef, graph, website } from '../lib/schema';

interface Preload {
  srcset: string;
  sizes: string;
  type: string;
  media?: string;
}

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, with slashes: "/sprinkler-repair/". */
  path: string;
  schema?: object[];
  preload?: Preload | Preload[];
  /** Where the header and sticky bar actions go. Pages with a quote band use #quote. */
  quoteHref?: string;
  noindex?: boolean;
  /** Hide the sticky bar (thank-you, legal). */
  bare?: boolean;
  /** This page is where a submitted form lands: count it as a lead. */
  lead?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, path, schema = [], preload, quoteHref = '#quote', noindex = false, bare = false, lead = false, ogImage, ogType = 'website' } = Astro.props;

const isPreview = import.meta.env.BASE_URL !== '/';
const canonical = `${BRAND.origin}${path}`;
const og = ogImage ? (ogImage.startsWith('http') ? ogImage : `${BRAND.origin}${ogImage}`) : `${BRAND.origin}/og-image.jpg`;
const loads = preload ? (Array.isArray(preload) ? preload : [preload]) : [];

const fontCss = `
@font-face{font-family:"Misty Text";src:url(${fontText}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap}
@font-face{font-family:"Misty Text";src:url(${fontItalic}) format("woff2");font-weight:100 900;font-style:italic;font-display:swap}
@font-face{font-family:"Misty Text Fallback";src:local("Arial"),local("Liberation Sans"),local("Helvetica Neue"),local("Roboto");size-adjust:96%;ascent-override:96%;descent-override:24%;line-gap-override:0%}`;
---

<!doctype html>
<html lang="en" data-lead={lead ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {path !== '/404/' && <link rel="canonical" href={canonical} />}
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b1220" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    {loads.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} type={p.type} media={p.media} fetchpriority="high" />)}
    <style set:html={fontCss}></style>
    <noscript>
      <style is:inline>
        .qf .qf__next, .qf .qf__back { display: none !important }
        .qf__step[hidden] { display: grid !important }
        .js-only { display: none !important }
      </style>
    </noscript>

    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={graph([path === '/' ? business() : businessRef(), website(), ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header quoteHref={quoteHref} current={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!bare && <StickyBar quoteHref={quoteHref} />}
    <Tracking />
  </body>
</html>
