---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';
---

<Base title={`Page not found | ${BRAND.name}`} description={`That page is not here. Find sprinkler startups, blowouts, repairs and new systems from ${BRAND.name} in ${BRAND.city}, MI.`} path="/404/" quoteHref="/book-service/" noindex bare>
  <PageHead eyebrow="Page not found" title="This zone **is not coming on.**" lede="The link may be old, or the page moved when the site was rebuilt. These will get you where you were going.">
    <ul class="chips" data-not-found>
      <li><a class="chip" href={href('/services/')}>All services</a></li>
      <li><a class="chip" href={href('/service-areas/')}>Service areas</a></li>
      <li><a class="chip" href={href('/book-service/')}>Book service</a></li>
      <li><a class="chip" href={href('/careers/')}>Job application</a></li>
    </ul>
    <div class="actions">
      <a class="btn primary" href={href('/')}>Go to the home page</a>
      <a class="btn ghost" href={BRAND.phoneHref} data-loc="404">Call {BRAND.phone}</a>
    </div>
  </PageHead>
</Base>
